<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="indy_eye_sensor" params="prefix parent camType:=camera">

    <gazebo reference="${parent}">
		<sensor name="${prefix}indy_eye_camera" type="${camType}">
			<visualize>true</visualize>
			<always_on>true</always_on>
			<update_rate>30.0</update_rate>
			<camera name="eye_camera">
			<horizontal_fov>1.047</horizontal_fov>
			<image>
				<width>640</width>
				<height>480</height>
				<format>R8G8B8</format>
			</image>
			<clip>
				<near>0.05</near>
				<far>8.0</far>
			</clip>
			</camera>
			<plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/image_raw</remapping>
          <remapping>camera_info:=/camera/camera_info</remapping>
        </ros>
        <frame_name>$(arg prefix)indy_eye_optical</frame_name>
        <xacro:if value="${camType == 'depth'}">
          <min_depth>0.05</min_depth>
          <max_depth>8.0</max_depth>
        </xacro:if>
			</plugin>
		</sensor>
	</gazebo>
  </xacro:macro>
</robot>